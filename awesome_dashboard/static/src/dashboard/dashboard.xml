<templates xml:space="preserve">
    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout displayProps="{ controlPanel: {} }" className="'o_dashboard h-100'">
            <div class="awesome_content d-flex flex-column gap-4">
                <div class="buttons d-flex align-items-center gap-3 my-3 mx-4">
                    <button t-on-click="openCustomers" class="btn btn-primary">Customers</button>
                    <button t-on-click="openLeads" class="btn btn-secondary">Leads</button>
                    <h4 class="mb-0">Dashboard</h4>
                </div>

                <div class="cards rounded p-4" t-if="statistics.isReady">
                    <div class="row g-4">
                        <t t-foreach="items" t-as="item" t-key="item.id">
                            <div class="col-12 col-md-4">
                                <DashboardItem>
                                    <t t-component="item.Component" t-props="item.props(statistics)" />
                                </DashboardItem>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </Layout>
    </t>
</templates>
