<templates xml:space="preserve">
    <t t-name="awesome_owl.counter">
        <div style="margin-right: 2%; padding-top: 20px;">
            <b class="fs-4">Counter: <t t-esc="state.value"/></b>
            <button class="btn btn_primary" t-on-click="increment"
                    style="background-color: mediumpurple; color: floralwhite; margin-left: 5px;">
                Increment
            </button>
        </div>
    </t>
</templates>
