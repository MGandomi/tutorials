<templates xml:space="preserve">
    <t t-name="awesome_owl.playground">
        <div class="container py-5">

            <div class="card shadow-sm mb-5">
                <div class="card-body">
                    <div class="row text-center">
                            <div class="col-md-2 mb-3 ">
                                <Counter t-props="{ onChange: () => this.incrementSum(), value: sum.value }"/>
                            </div>
	                    <div class="col-md-1 d-md-block ">
                            <div style="width: 1px; height: 100px; background-color: #ccc; margin: auto;"></div>
                        </div>
	                    <div class="col-md-2 mb-2 ">
                            <Counter t-props="{ onChange: () => this.incrementSum(), value: sum.value }"/>
	                    </div>
	                    <div class="col-md-1 d-md-block">
                            <div style="width: 1px; height: 100px; background-color: #ccc; margin: auto;"></div>
                        </div>

	                <div class="col-md-4">
                        <div class="d-flex flex-column align-items-center">
                            <h4 class="mb-3">sum : </h4>
	                        <span class="badge bg-primary fs-3 px-5 py-2">
                            <t t-esc="sum.value"/>
                            </span>
                        </div>
                    </div>


                    </div>
                </div>
            </div>

	        <div class="row g-4 justify-content-center">
	            <div class="col-12 col-md-5">
	                <div class="card h-100">
	                    <div class="card-body">
	                        <Card t-props="{ title: 'Card 1', content: 'This is simple text.', isMarkup: false }"/>
	                    </div>
	                </div>
	            </div>

		        <div class="col-12 col-md-5">
	                <div class="card h-100">
	                    <div class="card-body">
	                        <Card t-props="{ title: 'Card 2', content: '&lt;div style=&quot;color:red&quot;&gt;This is HTML content&lt;/div&gt;', isMarkup: true }"/>
	                    </div>
	                </div>
	            </div>
	        </div>

	        <div class="row justify-content-center mt-5">
                <div class="col-12 col-md-6">
                    <div class="card border-1 rounded-4">
                        <div class="card-header text-black text-center rounded-top-4">
                            <h5 class="my-2"> My Todo List</h5>
                        </div>
		                <div class="card-body">
	                        <TodoList/>
	                    </div>
                    </div>
                </div>
			</div>
        </div>
    </t>
</templates>
