<templates xml:space="preserve">
    <t t-name="awesome_owl.card">
        <div class="card d-inline-block m-2" style="width: 18rem;">
            <div class="card-body" >
                <h5 class="card-title">
                    <t t-esc="props.title"/>
                </h5>

                <t t-if="props.isMarkup">
                    <p class="card-text" >
                        <t t-out="props.content"/>
                    </p>
                </t>
                <t t-else="">
                    <p class="card-text">
                        <t t-esc="props.content"/>
                    </p>
                </t>

            </div>
        </div>
    </t>
</templates>
