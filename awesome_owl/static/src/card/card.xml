<templates xml:space="preserve">
    <t t-name="awesome_owl.card">
        <div class="card" style="width: 18rem; margin: 10px;">
            <div class="card-body">
                <h5 class="card-title">
                    <t t-esc="props.title"/>
                </h5>
                <p class="card-text">
                    <t t-if="props.isMarkup">
                        <t t-raw="props.content"/>
                    </t>
                    <t t-else="">
                        <t t-esc="props.content"/>
                    </t>
                </p>
            </div>
        </div>
    </t>
</templates>
