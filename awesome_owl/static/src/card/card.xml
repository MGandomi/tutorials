<t t-name="awesome_owl.card">
    <div class="card d-inline-block m-2" style="width: 18rem;">
        <div class="card-body">
            <h5 class="card-title"> Escaped: <t t-esc="props.title"/></h5>
            <p class="card-text"><t t-esc="props.content"/></p>

		    <h5 class="card-title mt-3"> Markup (HTML): <t t-out="props.title"/></h5>
            <p class="card-text"><t t-out="props.content"/></p>
	    </div>

    </div>


</t>
